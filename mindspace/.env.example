# ============================================================
# MindSpace — biến môi trường (chỉ placeholder, không commit .env thật)
# Local: copy thành mindspace/.env. Production: đặt trên Vercel.
# ============================================================

# ── Database: Neon project riêng của MindSpace (connection string có -pooler) ──
DATABASE_URL=

# ── Đăng nhập: qua MagerLife ────────────────────────────────
# Giống hệt MINDSPACE_SHARED_SECRET ở project MagerLife, >= 32 ký tự, khác MAGERLIFE_SESSION_SECRET.
MINDSPACE_SHARED_SECRET=
# Origin frontend MagerLife được gọi API, phân cách bằng dấu phẩy. Vd: https://<domain>,http://localhost:5173
MINDSPACE_CORS_ORIGINS=

# ── Claude ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
MINDSPACE_CHAT_MODEL=claude-sonnet-5-5       # viết câu trả lời
MINDSPACE_ANALYZER_MODEL=claude-haiku-5-5    # phân tích cảm xúc / ý định
MINDSPACE_CHAT_EFFORT=low                    # low | medium | high
MINDSPACE_LLM_TIMEOUT=30

# ── RAG (tắt mặc định) ──────────────────────────────────────
# Bật bằng MINDSPACE_RAG=1; khi đó cần AI_SERVICE_URL (HF Space embedding) và faiss-cpu, numpy.
MINDSPACE_RAG=0
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT=30

# ── Pipeline ────────────────────────────────────────────────
EMA_ALPHA=0.3
RETRIEVAL_TOP_K=3
RETRIEVAL_SCORE_THRESHOLD=0.3
RECENT_MSG_LIMIT=6
